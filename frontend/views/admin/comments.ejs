<%- include('../partials/admin-header') %>
<% const commentStatus = { PENDING: 'Chờ duyệt', APPROVED: 'Đã duyệt', REJECTED: 'Từ chối' }; %>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Người gửi</th><th>Bài viết</th><th>Nội dung</th><th>Trạng thái</th><th>Kiểm duyệt</th></tr></thead><tbody><% comments.forEach(c=> { %><tr><td><b><%= c.display_name || 'Khách' %></b></td><td><%= c.post_title %></td><td class="comment-cell"><%= c.content %></td><td><span class="status <%= c.status.toLowerCase() %>"><%= commentStatus[c.status] || c.status %></span></td><td><form class="inline moderation-form" method="post" action="/admin/comments/<%= c.id %>/status"><select name="status"><% ['PENDING','APPROVED','REJECTED'].forEach(s=> { %><option value="<%= s %>" <%= c.status===s?'selected':'' %>><%= commentStatus[s] %></option><% }) %></select><button class="btn small">Cập nhật</button></form></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/admin-footer') %>
