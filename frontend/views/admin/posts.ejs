<%- include('../partials/admin-header') %>
<% const postStatus = { PUBLISHED: 'Đã xuất bản', DRAFT: 'Bản nháp', HIDDEN: 'Đã ẩn' }; %>
<div class="toolbar"><a class="btn" href="/admin/posts/new">+ Tạo bài viết</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>ID</th><th>Tiêu đề</th><th>Chuyên mục</th><th>Tác giả</th><th>Trạng thái</th><th>Lượt xem</th><th>Thao tác</th></tr></thead><tbody><% posts.forEach(p=> { %><tr><td>#<%= p.id %></td><td><b><%= p.title %></b></td><td><%= p.category_name %></td><td><%= p.author_name %></td><td><span class="status <%= p.status.toLowerCase() %>"><%= postStatus[p.status] || p.status %></span></td><td><%= p.views %></td><td class="actions"><a class="btn small secondary" href="/admin/posts/<%= p.id %>/edit">Chỉnh sửa</a><% if (currentUser.role==='ADMIN') { %><form class="inline" method="post" action="/admin/posts/<%= p.id %>/delete" onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?')"><button class="btn small danger">Xóa</button></form><% } %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/admin-footer') %>
