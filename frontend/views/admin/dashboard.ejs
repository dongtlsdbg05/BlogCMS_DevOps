<%- include('../partials/admin-header') %>
<% const postStatus = { PUBLISHED: 'Đã xuất bản', DRAFT: 'Bản nháp', HIDDEN: 'Đã ẩn' }; %>
<div class="stats-grid"><div class="stat"><span>Bài viết</span><b><%= stats.posts %></b></div><div class="stat"><span>Chuyên mục</span><b><%= stats.categories %></b></div><div class="stat"><span>Tài khoản</span><b><%= stats.users %></b></div><div class="stat"><span>Bình luận chờ duyệt</span><b><%= stats.pending_comments %></b></div></div>
<section class="panel"><div class="panel-head"><h2>Nội dung cập nhật gần đây</h2><a class="btn small" href="/admin/posts/new">+ Tạo bài viết</a></div><div class="table-wrap"><table><thead><tr><th>Tiêu đề</th><th>Tác giả</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody><% recentPosts.forEach(p=> { %><tr><td><b><%= p.title %></b></td><td><%= p.author_name %></td><td><span class="status <%= p.status.toLowerCase() %>"><%= postStatus[p.status] || p.status %></span></td><td><%= new Date(p.updated_at).toLocaleString('vi-VN') %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/admin-footer') %>
