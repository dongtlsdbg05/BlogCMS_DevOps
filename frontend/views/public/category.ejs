<%- include('../partials/public-header') %><section class="container section"><span class="eyebrow">CHUYÊN MỤC</span><h1><%= category.name %></h1><p class="lead"><%= category.description || '' %></p><div class="list-cards"><% posts.forEach(p=> { %><a class="list-card" href="/post/<%= p.slug %>"><div><h3><%= p.title %></h3><p><%= p.summary || '' %></p></div><span><%= p.author_name %> →</span></a><% }) %></div><% if (!posts.length) { %><div class="empty">Chuyên mục này chưa có bài viết được xuất bản.</div><% } %></section><%- include('../partials/public-footer') %>
