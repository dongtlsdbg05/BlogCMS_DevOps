<%- include('../partials/public-header') %>
<article class="article"><div class="container narrow"><a class="badge" href="/category/<%= post.category_slug %>"><%= post.category_name %></a><h1><%= post.title %></h1><div class="meta big"><span><%= post.author_name %></span><span><%= new Date(post.published_at || post.created_at).toLocaleDateString('vi-VN') %></span><span><%= post.views + 1 %> lượt xem</span></div><% if (post.thumbnail_url) { %><img class="cover" src="<%= post.thumbnail_url %><%= post.thumbnail_url.startsWith('/') ? '?v=20261006-2' : '' %>" alt="Ảnh minh họa cho <%= post.title %>"><% } %><p class="lead"><%= post.summary || '' %></p><div class="article-content"><%= post.content %></div></div></article>
<section class="container narrow section"><h2>Thảo luận</h2><% if (message) { %><div class="notice success"><%= message %></div><% } %><form class="panel form-stack" method="post" action="/post/<%= post.id %>/comments"><% if (!currentUser) { %><div class="form-grid"><label>Họ và tên<input name="guest_name" required maxlength="100"></label><label>Email<input type="email" name="guest_email" required maxlength="120"></label></div><% } %><label>Nội dung bình luận<textarea name="content" rows="4" required minlength="3" maxlength="1500"></textarea></label><button class="btn">Gửi bình luận</button><small>Nội dung sẽ được hiển thị sau khi hoàn tất kiểm duyệt.</small></form><div class="comments"><% comments.forEach(c=> { %><div class="comment"><b><%= c.display_name || 'Khách' %></b><small><%= new Date(c.created_at).toLocaleString('vi-VN') %></small><p><%= c.content %></p></div><% }) %><% if (!comments.length) { %><p class="muted">Chưa có bình luận được hiển thị.</p><% } %></div><% if (related.length) { %><h3>Bài viết liên quan</h3><ul class="related"><% related.forEach(r=> { %><li><a href="/post/<%= r.slug %>"><%= r.title %></a></li><% }) %></ul><% } %></section>
<%- include('../partials/public-footer') %>
